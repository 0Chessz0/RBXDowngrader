<Window x:Class="RBXDowngrader.Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Install RBXDowngrader" Width="510" Height="430"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen" MouseLeftButtonDown="Window_MouseLeftButtonDown"
        Loaded="Window_Loaded">
    <Border Margin="18" CornerRadius="22" Background="#111111" BorderBrush="#303030" BorderThickness="1">
        <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="30" ShadowDepth="8" Opacity="0.65" /></Border.Effect>
        <Grid Margin="34,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Button HorizontalAlignment="Right" VerticalAlignment="Top" Width="32" Height="32" Background="Transparent" BorderThickness="0" Foreground="#929292" Cursor="Hand" Click="Close_Click">
                <Path Data="M 3,3 L 13,13 M 13,3 L 3,13" Stroke="#929292" StrokeThickness="1.5" />
            </Button>
            <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Width="92" Height="92" CornerRadius="23" HorizontalAlignment="Center">
                    <Border.Background>
                        <ImageBrush ImageSource="/app-icon.png" Viewbox="240,240,775,775" ViewboxUnits="Absolute" Stretch="UniformToFill" />
                    </Border.Background>
                </Border>
                <TextBlock Text="RBXDowngrader" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="25" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,20,0,0" />
                <TextBlock Text="Roblox version launcher" Foreground="#858585" FontSize="12" HorizontalAlignment="Center" Margin="0,7,0,0" />
            </StackPanel>
            <Border x:Name="CustomizationPanel" Grid.Row="2" Visibility="Collapsed" BorderBrush="#292929" BorderThickness="0,1,0,0" Padding="0,18,0,18" Margin="0,4,0,0">
                <StackPanel>
                    <CheckBox x:Name="AllUsersCheckBox" Content="Install for all users" Foreground="#C2C2C2" FontSize="12"
                              Checked="Scope_Changed" Unchecked="Scope_Changed" />
                    <TextBlock Text="INSTALLATION DIRECTORY" Foreground="#777777" FontSize="9" FontWeight="SemiBold" Margin="2,17,0,7" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Height="42" Background="#191919" BorderBrush="#303030" BorderThickness="1" CornerRadius="10">
                            <TextBox x:Name="DirectoryInput" Background="Transparent" BorderThickness="0" Foreground="#EAEAEA"
                                     FontFamily="Cascadia Mono, Consolas" FontSize="11" VerticalContentAlignment="Center" Padding="12,0" />
                        </Border>
                        <Button Grid.Column="1" Content="Browse" Style="{StaticResource TextButton}" Width="62" Margin="8,0,0,0" Click="Browse_Click" />
                    </Grid>
                </StackPanel>
            </Border>
            <StackPanel Grid.Row="3">
                <ProgressBar x:Name="Progress" Height="3" Maximum="100" Foreground="#356BDE" Background="#252525" BorderThickness="0" Visibility="Collapsed" Margin="0,0,0,14" />
                <Button x:Name="InstallButton" Style="{StaticResource Primary}" Content="Install" Click="Install_Click" />
                <Grid Height="28" Margin="0,5,-5,-8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="Status" Foreground="#777777" FontSize="10" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                    <Button x:Name="CustomizeButton" Grid.Column="1" Content="Customize installation" Style="{StaticResource TextButton}"
                            HorizontalAlignment="Right" Click="Customize_Click" />
                </Grid>
            </StackPanel>
        </Grid>
    </Border>
</Window>
