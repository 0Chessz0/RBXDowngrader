<Window x:Class="RBXDowngrader.Uninstaller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Uninstall RBXDowngrader" Width="510" Height="450"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen" MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Border Margin="18" CornerRadius="22" Background="#111111" BorderBrush="#303030" BorderThickness="1">
        <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="30" ShadowDepth="8" Opacity="0.65" /></Border.Effect>
        <Grid Margin="34,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Button HorizontalAlignment="Right" VerticalAlignment="Top" Width="32" Height="32" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="Close_Click">
                <Path Data="M 3,3 L 13,13 M 13,3 L 3,13" Stroke="#929292" StrokeThickness="1.5" />
            </Button>
            <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Width="82" Height="82" CornerRadius="21" HorizontalAlignment="Center">
                    <Border.Background>
                        <ImageBrush ImageSource="/app-icon.png" Viewbox="240,240,775,775" ViewboxUnits="Absolute" Stretch="UniformToFill" />
                    </Border.Background>
                </Border>
                <TextBlock Text="Uninstall RBXDowngrader?" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,20,0,0" />
                <TextBlock Text="The app and all its data will be removed" Foreground="#858585" FontSize="12" HorizontalAlignment="Center" Margin="0,8,0,0" />
            </StackPanel>
            <StackPanel Grid.Row="2">
                <CheckBox x:Name="KeepVersions" Content="Keep downloaded Roblox versions" Foreground="#B0B0B0" FontSize="12" Margin="3,0,0,16" />
                <Button x:Name="UninstallButton" Style="{StaticResource Primary}" Content="Uninstall" Click="Uninstall_Click" />
                <TextBlock x:Name="Status" Foreground="#696969" FontSize="10" HorizontalAlignment="Center" Margin="0,10,0,0" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
