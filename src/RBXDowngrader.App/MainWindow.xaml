<Window x:Class="RBXDowngrader.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        Title="RBXDowngrader"
        Width="940" Height="640" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        Loaded="Window_Loaded"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Border Margin="18" CornerRadius="22" Background="{StaticResource SurfaceBrush}" BorderBrush="#303030" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="30" ShadowDepth="8" Opacity="0.65" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="64" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="60" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="22,0,14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="9">
                        <Border.Background>
                            <ImageBrush ImageSource="/Assets/app-icon.png" Viewbox="240,240,775,775" ViewboxUnits="Absolute" Stretch="UniformToFill" />
                        </Border.Background>
                    </Border>
                    <TextBlock Text="RBXDowngrader" FontFamily="Segoe UI Variable Display, Segoe UI" FontWeight="SemiBold" FontSize="16" Margin="12,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource IconButton}" Click="Minimize_Click" ToolTip="Minimize">
                        <Path Data="M 3,8 L 13,8" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" />
                    </Button>
                    <Button Style="{StaticResource IconButton}" Click="Close_Click" ToolTip="Close">
                        <Path Data="M 3,3 L 13,13 M 13,3 L 3,13" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" />
                    </Button>
                </StackPanel>
            </Grid>

            <Border x:Name="UpdateBanner" Grid.Row="1" Margin="34,0,34,6" Padding="14,7"
                    Background="#18233A" BorderBrush="#294A7A" BorderThickness="1" CornerRadius="10"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="UpdateBannerText" Text="Update available" Foreground="#BFD2FF"
                                       FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Button x:Name="WhatsNewButton" Content="What's new" Style="{StaticResource TextButton}"
                                    Height="28" Margin="8,0,0,0" Visibility="Collapsed" Click="WhatsNew_Click" />
                        </StackPanel>
                        <Button x:Name="SkipUpdateButton" Grid.Column="1" Content="Skip" Style="{StaticResource TextButton}"
                                Height="32" Margin="8,0,4,0" Click="SkipUpdate_Click" />
                        <Button x:Name="UpdateButton" Grid.Column="2" Content="Update" Style="{StaticResource SecondaryButton}"
                                Width="76" Height="32" Margin="14,0,0,0" Click="Update_Click" />
                    </Grid>
                    <Border x:Name="ReleaseNotesPanel" Grid.Row="1" Margin="0,7,0,3" Padding="10,8"
                            Background="#111A2C" CornerRadius="7" Visibility="Collapsed">
                        <TextBlock x:Name="ReleaseNotesText" Foreground="#A9BCE2" FontSize="11"
                                   LineHeight="17" TextWrapping="Wrap" />
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Row="2" Margin="34,14,34,26">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="VERSION HASH" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="SemiBold" Margin="2,0,0,8" />
                    <Border Height="48" Background="{StaticResource RaisedBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="12">
                        <TextBox x:Name="VersionInput" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}"
                                 CaretBrush="{StaticResource AccentBrush}" FontFamily="Cascadia Mono, Consolas" FontSize="14"
                                 VerticalContentAlignment="Center" Padding="16,0" MaxLength="24" TextChanged="VersionInput_TextChanged"
                                 KeyDown="VersionInput_KeyDown" DataObject.Pasting="VersionInput_Pasting" />
                    </Border>
                </StackPanel>
                <Grid Grid.Column="2" VerticalAlignment="Bottom">
                    <Button x:Name="RecentBuildsButton" Style="{StaticResource SecondaryButton}" Width="48" Height="48"
                            Padding="0" ToolTip="Recent builds" Click="RecentBuilds_Click">
                        <Viewbox Width="18" Height="18">
                            <Canvas Width="20" Height="20">
                                <Path Data="M10,3 A7,7 0 1 0 17,10 A7,7 0 0 0 10,3 M10,6 L10,10 L13,12"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent" />
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <primitives:Popup x:Name="RecentBuildsPopup" PlacementTarget="{Binding ElementName=RecentBuildsButton}"
                                      Placement="Bottom" HorizontalOffset="-282" VerticalOffset="8"
                                      AllowsTransparency="True" StaysOpen="False">
                        <Border Width="330" Background="#181818" BorderBrush="#343434" BorderThickness="1" CornerRadius="12" Padding="7">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="22" ShadowDepth="7" Opacity="0.7" />
                            </Border.Effect>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="RecentBuildsState" Text="Loading" Foreground="{StaticResource MutedBrush}"
                                           FontSize="11" Margin="12,14" Grid.RowSpan="2" />
                                <TextBlock x:Name="CachedResultsText" Text="Showing cached results" Foreground="#8A8A8A"
                                           FontSize="10" Margin="11,7,11,3" Visibility="Collapsed" />
                                <ItemsControl x:Name="RecentBuildsList" Grid.Row="1" ItemsSource="{Binding RecentBuilds}" Visibility="Collapsed">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Background="Transparent" BorderThickness="0" Padding="11,9" Cursor="Hand"
                                                    HorizontalContentAlignment="Stretch" Click="RecentBuild_Click">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="RecentChrome" Background="{TemplateBinding Background}" CornerRadius="8"
                                                                Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Stretch" />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="RecentChrome" Property="Background" Value="#252525" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding DisplayVersion}" FontSize="12" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding ShortHash}" FontFamily="Cascadia Mono, Consolas"
                                                                   Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,3,0,0" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding StatusText}" Foreground="#6F9BFF"
                                                               FontSize="9" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Border>
                    </primitives:Popup>
                </Grid>
                <Button x:Name="CheckUpdatesButton" Grid.Column="4" Style="{StaticResource SecondaryButton}" Width="64" Height="48"
                        VerticalAlignment="Bottom" Content="Check" Click="CheckUpdates_Click" ToolTip="Check for updates" />
                <Button x:Name="DownloadButton" Grid.Column="6" Style="{StaticResource PrimaryButton}" Width="128" VerticalAlignment="Bottom"
                        Content="Download" IsEnabled="False" Click="Download_Click" />
            </Grid>

            <Grid Grid.Row="3" Margin="34,0,34,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="32" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid>
                    <TextBlock Text="INSTALLED" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock x:Name="VersionCount" Foreground="#666666" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>

                <Grid Grid.Row="1">
                    <Border x:Name="EmptyState" Background="#141414" CornerRadius="14" BorderBrush="#242424" BorderThickness="1">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Width="48" Height="48" CornerRadius="14" Background="#1D1D1D" Margin="0,0,0,14">
                                <Path Data="M 8,4 L 8,16 M 3,11 L 8,16 L 13,11" Stroke="#626262" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="No versions installed" Foreground="#777777" FontSize="13" />
                        </StackPanel>
                    </Border>

                    <ListView x:Name="VersionsList" ItemsSource="{Binding Versions}" Background="Transparent" BorderThickness="0"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.Resources>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,8" />
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListViewItem">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListView.Resources>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Height="66" Background="#171717" BorderBrush="#252525" BorderThickness="1" CornerRadius="14" Padding="16,0,12,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="42" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="32" Height="32" CornerRadius="9" Background="#222222" VerticalAlignment="Center">
                                            <Path Data="M 4,4 L 14,4 L 14,14 L 4,14 Z M 7,7 L 11,7 L 11,11 L 7,11 Z" Fill="#CFCFCF" Stretch="Uniform" Width="16" Height="16" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                                            <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding DetailsText}" Foreground="{StaticResource MutedBrush}" FontSize="11"
                                                       Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Style="{StaticResource IconButton}" Width="40" Height="40" ToolTip="Rename" Click="Rename_Click">
                                                <Viewbox Width="18" Height="18">
                                                    <Canvas Width="20" Height="20">
                                                        <Path Data="M5,14 L4,17 L7,16 L15,8 L12,5 Z M11,6 L14,9"
                                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                              StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" />
                                                    </Canvas>
                                                </Viewbox>
                                            </Button>
                                            <Button Style="{StaticResource IconButton}" Width="40" Height="40" ToolTip="Delete" Click="Delete_Click">
                                                <Viewbox Width="18" Height="18">
                                                    <Canvas Width="20" Height="20">
                                                        <Path Data="M4,6 L16,6 M8,6 L8,4 L12,4 L12,6 M6.5,8 L7.2,16 L12.8,16 L13.5,8"
                                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                              StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" />
                                                    </Canvas>
                                                </Viewbox>
                                            </Button>
                                            <Button Style="{StaticResource SecondaryButton}" Width="114" Height="40" Margin="6,0,0,0"
                                                    Content="Private server" Click="PrivateServer_Click" />
                                            <Button Style="{StaticResource PrimaryButton}" Width="92" Height="40" Margin="6,0,0,0" Content="Launch" Click="Launch_Click" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Grid>

            <Grid Grid.Row="4" Margin="34,12,34,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="VersionLabel" Foreground="#666666" FontSize="10" />
                    <TextBlock x:Name="StatusText" Foreground="{StaticResource MutedBrush}" FontSize="11" Visibility="Collapsed" />
                    <ProgressBar x:Name="DownloadProgress" Height="3" Margin="0,10,0,0" Maximum="100" Value="0" Background="#242424" Foreground="{StaticResource AccentBrush}" BorderThickness="0" Visibility="Collapsed" />
                </StackPanel>
                <Button x:Name="CancelButton" Grid.Column="1" Content="Cancel" Foreground="#A0A0A0" Background="Transparent" BorderThickness="0"
                        FontSize="11" Cursor="Hand" Visibility="Collapsed" Click="Cancel_Click" Margin="18,0,0,0" />
            </Grid>
        </Grid>
    </Border>
</Window>
