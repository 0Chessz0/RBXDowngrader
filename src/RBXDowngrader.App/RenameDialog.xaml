<Window x:Class="RBXDowngrader.RenameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="420" Height="240" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Loaded="Window_Loaded" MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Border Margin="16" CornerRadius="18" Background="#151515" BorderBrush="#303030" BorderThickness="1" Padding="26">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="24" ShadowDepth="7" Opacity="0.7" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="42" />
            </Grid.RowDefinitions>
            <TextBlock Text="Rename client" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="18" FontWeight="SemiBold" />
            <Border Grid.Row="1" Height="44" Background="#1A1A1A" BorderBrush="#303030" BorderThickness="1" CornerRadius="10" Margin="0,18,0,0">
                <TextBox x:Name="NameInput" Background="Transparent" BorderThickness="0" Foreground="#F1F1F1"
                         CaretBrush="#477CE8" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
                         VerticalContentAlignment="Center" Padding="12,0" MaxLength="40"
                         TextChanged="NameInput_TextChanged" KeyDown="NameInput_KeyDown" />
            </Border>
            <TextBlock x:Name="ValidationText" Grid.Row="2" Text="Use 1 to 40 characters"
                       Foreground="#FF6F6F" FontSize="10" Margin="2,7,0,0" Visibility="Collapsed" />
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Width="80" Height="42" Click="Cancel_Click" />
                <Button Content="Save" Style="{StaticResource PrimaryButton}" Width="82" Height="42" Margin="8,0,0,0" Click="Save_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
