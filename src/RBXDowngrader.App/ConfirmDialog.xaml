<Window x:Class="RBXDowngrader.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="390" Height="220" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Border Margin="16" CornerRadius="18" Background="#151515" BorderBrush="#303030" BorderThickness="1" Padding="26">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="24" ShadowDepth="7" Opacity="0.7" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="42" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="Heading" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="18" FontWeight="SemiBold" />
            <TextBlock x:Name="Message" Grid.Row="1" Foreground="#989898" TextWrapping="Wrap" Margin="0,10,0,16" FontSize="12" />
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Style="{StaticResource IconButton}" Width="76" Height="42" Click="Cancel_Click" />
                <Button Content="Delete" Style="{StaticResource PrimaryButton}" Width="88" Height="42" Margin="8,0,0,0" Background="#FF5656" Foreground="#FFFFFF" Click="Confirm_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
